// Configuración para ejecutar mediante pybricksdev desde VS Code
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pybricks BLE: Run File",
            "type": "debugpy",
            "request": "launch",
            "module": "pybricksdev",
            "args": ["run", "ble", "${file}"]
        }
    ]
}
